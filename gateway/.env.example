# Gateway secrets. Copy to .env on the VPS and fill in real values.

# Signing key for the JWTs we hand to the mobile app on /login.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Shared secret between gateway and each PC's server. Used to authenticate
# /setup calls (PC announces its passwordHash) and /firebase-config downloads.
# Generate with: openssl rand -hex 32
SETUP_SECRET=

# Public IP/hostname of the VPS. Returned to clients claiming an invite so
# their SSH tunnel knows where to connect.
VPS_HOST=

# Optional: override the tunnel user the gateway tells clients to connect as.
# Defaults to "claude-tunnel".
# TUNNEL_USER=claude-tunnel

# Optional: where the gateway writes accepted SSH public keys.
# Defaults to /home/${TUNNEL_USER}/.ssh/authorized_keys.
# AUTHORIZED_KEYS=/home/claude-tunnel/.ssh/authorized_keys

# Port the Node gateway listens on (Caddy proxies to it).
PORT=3000
