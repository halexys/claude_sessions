# Generated by install.sh — kept here only as reference.
# The real version is written into ~/.config/systemd/user/claude-tunnel.service.

[Unit]
Description=Claude SSH Tunnel
After=network.target claude-mobile.service
Wants=claude-mobile.service

[Service]
ExecStart=/home/USER/.local/bin/claude-tunnel.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
