# This file is generated by install.sh at install time — keep it here only
# as a reference. The real version is written into
# ~/.config/systemd/user/claude-mobile.service with the resolved node path
# and the actual install directory.

[Unit]
Description=Claude Mobile Server
After=network.target

[Service]
WorkingDirectory=/home/USER/.local/share/claude-mobile
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3
EnvironmentFile=/home/USER/.local/share/claude-mobile/.env

[Install]
WantedBy=default.target
